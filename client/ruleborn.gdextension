; The simulation, as a GDExtension (§24.7). client/build.sh builds it into
; bin/; iOS and Android entries join when the store builds do (T4).
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = false

[libraries]
linux.x86_64 = "res://bin/libruleborn_godot.so"
