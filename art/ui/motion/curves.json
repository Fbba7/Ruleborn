{
  "about": "Every interface motion's times and easing (report.md step 8 and section 10.3). Rules from §21.8 (D3 (b)): every step lasts 150 to 250 ms and eases out, nothing overshoots its end value, a press squashes slightly, rewards fly into their counter, shake is never above 4 px. From §20.8: each motion names its reduced form, which drops swoops and particles but keeps one coin landing in its counter, and nothing repeats faster than three times a second. Times are in milliseconds from the motion's start; distances in points (the kit's UI.px turns them into pixels); sprites are pieces of client/ui/art/motion.json. check_curves.py holds this file to these rules.",
  "version": 1,
  "rules": {
    "shortest_ms": 150,
    "longest_ms": 250,
    "easings": ["cubic_out"],
    "overshoot": false,
    "flash_hz_most": 3,
    "shake_px_most": 4,
    "shake_switchable": true
  },
  "easings": {
    "cubic_out": {
      "formula": "1 - (1 - t)^3",
      "godot": {"trans": "TRANS_CUBIC", "ease": "EASE_OUT"},
      "overshoot": false
    }
  },
  "motions": {
    "press": {
      "about": "A button pressed and let go: its body sinks onto its lip, squashes slightly, and recovers when let go.",
      "full": {
        "down": [
          {"name": "sink", "property": "press", "from": 0.0, "to": 1.0, "at_ms": 0, "ms": 150, "easing": "cubic_out"},
          {"name": "squash", "property": "scale", "from": 1.0, "to": 0.96, "at_ms": 0, "ms": 150, "easing": "cubic_out"}
        ],
        "up": [
          {"name": "rise", "property": "press", "from": 1.0, "to": 0.0, "at_ms": 0, "ms": 180, "easing": "cubic_out"},
          {"name": "recover", "property": "scale", "from": 0.96, "to": 1.0, "at_ms": 0, "ms": 180, "easing": "cubic_out"}
        ]
      },
      "reduced": {
        "form": "Sinks and darkens, no squash.",
        "down": [
          {"name": "sink", "property": "press", "from": 0.0, "to": 1.0, "at_ms": 0, "ms": 150, "easing": "cubic_out"},
          {"name": "darken", "property": "self_modulate_value", "from": 1.0, "to": 0.88, "at_ms": 0, "ms": 150, "easing": "cubic_out"}
        ],
        "up": [
          {"name": "rise", "property": "press", "from": 1.0, "to": 0.0, "at_ms": 0, "ms": 150, "easing": "cubic_out"},
          {"name": "lighten", "property": "self_modulate_value", "from": 0.88, "to": 1.0, "at_ms": 0, "ms": 150, "easing": "cubic_out"}
        ]
      }
    },
    "reward": {
      "about": "The result screen's reward sequence: the prize gathers (anticipation), bursts, is revealed, its coins fly in arcs to their counter, and the counter rolls to its new value and pulses once. The coins share one sprite strip (coin face, turn, edge, turn) at frame_ms a frame: a coin turning, not a flash. The counter pulses once, when the last coin lands, never once a coin.",
      "full": {
        "steps": [
          {"name": "anticipation", "target": "prize", "property": "scale", "from": 1.0, "to": 0.94, "at_ms": 0, "ms": 150, "easing": "cubic_out"},
          {"name": "burst_rays", "target": "burst", "sprite": "burst__rays__normal", "property": "scale", "from": 0.4, "to": 1.0, "at_ms": 150, "ms": 220, "easing": "cubic_out"},
          {"name": "burst_rays_fade", "target": "burst", "sprite": "burst__rays__normal", "property": "alpha", "from": 1.0, "to": 0.0, "at_ms": 250, "ms": 250, "easing": "cubic_out"},
          {"name": "burst_ring", "target": "burst", "sprite": "burst__ring__normal", "property": "scale", "from": 0.3, "to": 1.0, "at_ms": 150, "ms": 200, "easing": "cubic_out"},
          {"name": "burst_ring_fade", "target": "burst", "sprite": "burst__ring__normal", "property": "alpha", "from": 1.0, "to": 0.0, "at_ms": 200, "ms": 200, "easing": "cubic_out"},
          {"name": "sparkles", "target": "burst", "sprite": "sparkle__star__normal", "count": 6, "stagger_ms": 30, "property": "offset_points", "from": 0, "to": 34, "at_ms": 150, "ms": 250, "easing": "cubic_out"},
          {"name": "sparkles_fade", "target": "burst", "sprite": "sparkle__star__normal", "count": 6, "stagger_ms": 30, "property": "alpha", "from": 1.0, "to": 0.0, "at_ms": 250, "ms": 200, "easing": "cubic_out"},
          {"name": "dust", "target": "burst", "sprite": "sparkle__dot__normal", "count": 8, "stagger_ms": 30, "property": "offset_points", "from": 0, "to": 24, "at_ms": 170, "ms": 220, "easing": "cubic_out"},
          {"name": "dust_fade", "target": "burst", "sprite": "sparkle__dot__normal", "count": 8, "stagger_ms": 30, "property": "alpha", "from": 1.0, "to": 0.0, "at_ms": 240, "ms": 150, "easing": "cubic_out"},
          {"name": "reveal_scale", "target": "prize", "property": "scale", "from": 0.94, "to": 1.0, "at_ms": 150, "ms": 200, "easing": "cubic_out"},
          {"name": "reveal_rise", "target": "prize", "property": "offset_points", "from": 10, "to": 0, "at_ms": 150, "ms": 220, "easing": "cubic_out"},
          {"name": "reveal_fade", "target": "prize", "property": "alpha", "from": 0.0, "to": 1.0, "at_ms": 150, "ms": 150, "easing": "cubic_out"},
          {"name": "coins_fly", "target": "coin", "sprites": ["coin__face__normal", "coin__turn__normal", "coin__edge__normal", "coin__turn__normal"], "frame_ms": 62, "count": 8, "stagger_ms": 30, "property": "arc", "arc_points": 44, "from": "prize", "to": "counter", "at_ms": 400, "ms": 250, "easing": "cubic_out"},
          {"name": "coins_shrink", "target": "coin", "count": 8, "stagger_ms": 30, "property": "scale", "from": 1.0, "to": 0.7, "at_ms": 400, "ms": 250, "easing": "cubic_out"},
          {"name": "counter_roll", "target": "counter", "property": "value", "from": "old", "to": "new", "at_ms": 650, "ms": 250, "easing": "cubic_out"},
          {"name": "counter_pulse_up", "target": "counter", "property": "scale", "from": 1.0, "to": 1.08, "at_ms": 860, "ms": 150, "easing": "cubic_out"},
          {"name": "counter_pulse_down", "target": "counter", "property": "scale", "from": 1.08, "to": 1.0, "at_ms": 1010, "ms": 200, "easing": "cubic_out"}
        ],
        "high_contrast": "The same steps with each sprite's _hc twin from motion_hc.webp."
      },
      "reduced": {
        "form": "No anticipation or burst. The prize cross-fades in, one coin lands in its counter (the one particle §20.8 keeps), and the counter shows its new value at once.",
        "steps": [
          {"name": "reveal_fade", "target": "prize", "property": "alpha", "from": 0.0, "to": 1.0, "at_ms": 0, "ms": 150, "easing": "cubic_out"},
          {"name": "coin_land", "target": "coin", "sprite": "coin__face__normal", "count": 1, "property": "offset_points", "from": -10, "to": 0, "at_ms": 150, "ms": 200, "easing": "cubic_out"},
          {"name": "coin_land_fade", "target": "coin", "sprite": "coin__face__normal", "count": 1, "property": "alpha", "from": 1.0, "to": 0.0, "at_ms": 200, "ms": 150, "easing": "cubic_out"},
          {"name": "counter_set", "target": "counter", "property": "value", "from": "old", "to": "new", "at_ms": 350, "ms": 0, "easing": "none"}
        ]
      }
    },
    "shine": {
      "about": "An idle shine on primary buttons: a soft band sweeps across the face once every period_ms, after a first wait, and only while the button is enabled and idle. Once every 3.2 s is far below §20.8's three times a second. Not drawn in high contrast: the band would blur the outline that mode keeps.",
      "full": {
        "first_wait_ms": 1200,
        "period_ms": 3200,
        "steps": [
          {"name": "sweep", "target": "button", "sprite": "shine__sweep__normal", "property": "x_fraction", "from": -0.3, "to": 1.3, "at_ms": 0, "ms": 250, "easing": "cubic_out"},
          {"name": "sweep_fade", "target": "button", "sprite": "shine__sweep__normal", "property": "alpha", "from": 0.6, "to": 0.0, "at_ms": 100, "ms": 150, "easing": "cubic_out"}
        ],
        "high_contrast": "none"
      },
      "reduced": {
        "form": "None.",
        "steps": []
      }
    },
    "screen": {
      "about": "A screen change: the old screen fades out, the new one fades in from 0.985 of its size.",
      "full": {
        "out": [
          {"name": "fade_out", "target": "old_screen", "property": "alpha", "from": 1.0, "to": 0.0, "at_ms": 0, "ms": 160, "easing": "cubic_out"}
        ],
        "in": [
          {"name": "fade_in", "target": "new_screen", "property": "alpha", "from": 0.0, "to": 1.0, "at_ms": 0, "ms": 180, "easing": "cubic_out"},
          {"name": "grow", "target": "new_screen", "property": "scale", "from": 0.985, "to": 1.0, "at_ms": 0, "ms": 180, "easing": "cubic_out"}
        ]
      },
      "reduced": {
        "form": "A cross-fade.",
        "in": [
          {"name": "fade_in", "target": "new_screen", "property": "alpha", "from": 0.0, "to": 1.0, "at_ms": 0, "ms": 150, "easing": "cubic_out"}
        ]
      }
    }
  }
}
