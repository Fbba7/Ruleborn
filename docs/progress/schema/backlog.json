{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/progress/schema/backlog.json",
  "title": "The backlog: docs/progress/backlog.json and docs/progress/backlog.example.json",
  "description": "From docs/guides/agent-protocol.md ('Tasks and their states', 'The task format', 'Messages and requests') and the live files. Checked by tools/docs/protocol_check.py, which also checks that the protocol names every field here.",
  "type": "object",
  "required": ["wave", "phase", "updated_at", "updated_by", "stop_at", "tasks", "messages"],
  "additionalProperties": false,
  "properties": {
    "_comment": {"type": "string"},
    "wave": {"type": "string"},
    "phase": {"type": ["integer", "string"]},
    "updated_at": {"$ref": "#/$defs/utc"},
    "updated_by": {"type": "string"},
    "stop_at": {"$ref": "#/$defs/utc"},
    "lease_hours": {"type": "number", "minimum": 0},
    "status_every_minutes": {"type": "number", "minimum": 0},
    "check_minutes": {"type": "number", "minimum": 0},
    "building_cap": {"type": "integer", "minimum": 0},
    "verdicts_dir": {"type": "string"},
    "strings_owner": {"type": "string"},
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["branch", "model"],
        "additionalProperties": false,
        "properties": {"branch": {"type": "string"}, "model": {"type": "string"}}
      }
    },
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "idle_queue": {"type": "array", "items": {"$ref": "#/$defs/idle_task"}},
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}}
  },
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"},
    "sha_or_null": {"type": ["string", "null"]},
    "task_state": {
      "enum": ["open", "claimed", "working", "ready", "resync", "blocked", "merged", "parked"]
    },
    "claim": {
      "type": "object",
      "required": ["agent", "branch", "claimed_at", "seen_at", "lease_until"],
      "additionalProperties": false,
      "properties": {
        "agent": {"type": "string"},
        "branch": {"type": "string"},
        "claimed_at": {"$ref": "#/$defs/utc"},
        "seen_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "lease_until": {"$ref": "#/$defs/utc"}
      }
    },
    "gate_item": {
      "type": "object",
      "required": ["item", "qualities"],
      "additionalProperties": false,
      "properties": {
        "item": {"type": "string"},
        "qualities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "phase", "role", "assigned_to", "model", "files", "deps", "done_when",
                   "gate_items", "attempts", "estimate_h", "tier", "critical", "state", "claim",
                   "prior_branch", "prior_sha", "ready_sha", "merged_sha"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "phase": {"type": ["integer", "string"]},
        "role": {"type": "string"},
        "assigned_to": {"type": ["string", "null"]},
        "model": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}},
        "exceptions": {"type": "array", "items": {"type": "string"}},
        "deps": {"type": "array", "items": {"type": "string"}},
        "done_when": {"type": "array", "items": {"type": "string"}},
        "gate_items": {"type": "array", "items": {"$ref": "#/$defs/gate_item"}},
        "attempts": {"type": "integer", "minimum": 0},
        "estimate_h": {"type": "number", "minimum": 0},
        "tier": {"enum": [1, 2, 3]},
        "critical": {"type": "boolean"},
        "state": {"$ref": "#/$defs/task_state"},
        "claim": {"anyOf": [{"$ref": "#/$defs/claim"}, {"type": "null"}]},
        "prior_branch": {"type": ["string", "null"]},
        "prior_sha": {"$ref": "#/$defs/sha_or_null"},
        "ready_sha": {"$ref": "#/$defs/sha_or_null"},
        "merged_sha": {"$ref": "#/$defs/sha_or_null"},
        "updated_at": {"$ref": "#/$defs/utc"},
        "updated_by": {"type": "string"}
      }
    },
    "idle_task": {
      "type": "object",
      "required": ["id", "title", "role", "model", "assigned_to", "files", "estimate_h", "tier", "state", "claim"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "role": {"type": "string"},
        "model": {"type": "string"},
        "assigned_to": {"type": ["string", "null"]},
        "files": {"type": "array", "items": {"type": "string"}},
        "estimate_h": {"type": "number", "minimum": 0},
        "tier": {"enum": [1, 2, 3]},
        "state": {"$ref": "#/$defs/task_state"},
        "claim": {"anyOf": [{"$ref": "#/$defs/claim"}, {"type": "null"}]}
      }
    },
    "message": {
      "type": "object",
      "required": ["id", "to", "text", "sent_at", "ack_by", "acked_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^M[0-9]+$"},
        "to": {"type": "string"},
        "text": {"type": "string"},
        "sent_at": {"$ref": "#/$defs/utc"},
        "ack_by": {"$ref": "#/$defs/utc"},
        "acked_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]}
      }
    }
  }
}
